{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uf0rs-files",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": false,
  "preview_urls": false,
  "env": {
    "dev": {
      "name": "uf0rs-dev-files",
      "routes": [{ "pattern": "dev.wopps.ai/files/*", "zone_name": "wopps.ai" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "uf0rs-dev-files" }],
    },
    "production": {
      "name": "uf0rs-production-files",
      "routes": [{ "pattern": "wopps.ai/files/*", "zone_name": "wopps.ai" }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "uf0rs-production-files" }],
    },
  },
}
