{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@uf0rs/plugin-browser",
  "version": "2.2.5",
  "description": "WOPPS's desktop browser plugin",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uf0rs/wopps-ai.git",
    "directory": "packages/plugin-browser"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts",
    "./proxy": "./src/proxy.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack": "bun run script/pack.ts",
    "typecheck": "bun check --no-script -p tsconfig.test.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@uf0rs/plugin": "workspace:*",
    "@uf0rs/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
