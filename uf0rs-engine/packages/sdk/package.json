{
  "$schema": "https://json.schemastore.org/package.json",
  "version": "2.2.5",
  "name": "@uf0rs/sdk",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uf0rs/wopps-agent.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./effect": "./src/effect/index.ts",
    "./workerd": "./src/workerd.ts",
    "./workerd/effect": "./src/effect/workerd.ts"
  },
  "scripts": {
    "build": "bun run script/build.ts",
    "pack": "bun run script/pack.ts",
    "test": "bun test --timeout 5000",
    "typecheck": "bun check --no-script -b",
    "typecheck:tsc": "tsc -b",
    "verify:package": "bun run script/verify-package.ts"
  },
  "dependencies": {
    "@uf0rs/client": "workspace:*",
    "@uf0rs/core": "workspace:*",
    "@uf0rs/plugin": "workspace:*",
    "@uf0rs/schema": "workspace:*",
    "@uf0rs/server": "workspace:*",
    "@uf0rs/util": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@uf0rs/ai": "workspace:*",
    "@uf0rs/httpapi-codegen": "workspace:*",
    "@uf0rs/protocol": "workspace:*",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:"
  }
}
